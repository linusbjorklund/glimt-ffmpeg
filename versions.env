# Pinned inputs of the build. build.sh reads this file.
#
# To make a new build: change what needs changing here, commit, and push a tag
# named v<MEDIA3_VERSION>-<build number>, for example v1.11.1-2.

# Media3 release tag and the commit it points at (https://github.com/androidx/media).
MEDIA3_VERSION=1.11.1
MEDIA3_COMMIT=8c6678b657ede1e7883fc164ef73ed483c7796c3

# FFmpeg release branch and commit (https://git.ffmpeg.org/ffmpeg.git).
# The branch and the NDK below are the ones named in the README of Media3's
# libraries/decoder_ffmpeg at the pinned tag.
FFMPEG_BRANCH=release/6.0
FFMPEG_COMMIT=b4a62c32549b8295691a8e0ff2c9b82188923159

# Android NDK and CMake, as named by the Android SDK manager.
NDK_RELEASE=r26b
NDK_VERSION=26.1.10909125
CMAKE_VERSION=3.22.1

# Android API level the native code is built for. Equal to Media3's minSdk.
ANDROID_API=23

# FFmpeg decoders to compile in. Everything else stays disabled.
DECODERS="ac3 eac3 dca mp3"
